# ================================================================
#  TurboFix Backend — Environment Variables
#  Copy to .env and fill in real values. NEVER commit .env.
# ================================================================

# ── Server ────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ── Supabase / PostgreSQL ─────────────────────────────────────────
# For Supabase: Get these from Dashboard → Settings → Database
DB_HOST=db.qaihyfxuntzsibubvpxb.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_supabase_database_password
DB_NAME=postgres
DB_SSL=true

# ── JWT ───────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_min_64_chars_change_this_immediately
JWT_EXPIRES_IN=24h

# ── CORS — Allowed Frontend Origins ──────────────────────────────
FRONTEND_URL=https://turbofix-mobiles.netlify.app
CRM_URL=https://crm-turbofix.netlify.app

# ── Rate Limiting ─────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── File Uploads ──────────────────────────────────────────────────
MAX_FILE_SIZE_MB=10


# -- Business ---------------------------------------------------
BUSINESS_NAME=TurboFix
BUSINESS_PHONE=+918639605147
BUSINESS_EMAIL=support@turbofix.in
BUSINESS_ADDRESS=11-1-441, Aghapura, Nampally, Hyderabad

# -- Email / SMTP -----------------------------------------------
# Option 1 - Brevo:  SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587
# Option 2 - Gmail (App Password): SMTP_HOST=smtp.gmail.com  SMTP_PORT=587
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=support@turbofix.in
SMTP_PASS=your_smtp_password_here
SMTP_FROM=TurboFix <support@turbofix.in>
