# ================================================================
#  TurboFix Backend — Environment Variables
#  Copy to .env and fill in real values. NEVER commit .env.
# ================================================================

# ── Server ────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ── Supabase / PostgreSQL ─────────────────────────────────────────
# For Supabase: Get these from Dashboard → Settings → Database
DB_HOST=db.qaihyfxuntzsibubvpxb.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_supabase_database_password
DB_NAME=postgres
DB_SSL=true

# ── JWT ───────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_min_64_chars_change_this_immediately
JWT_EXPIRES_IN=24h

# ── CORS — Allowed Frontend Origins ──────────────────────────────
FRONTEND_URL=https://turbofix.in
CRM_URL=https://crm.turbofix.in

# ── Rate Limiting ─────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── File Uploads ──────────────────────────────────────────────────
MAX_FILE_SIZE_MB=10
